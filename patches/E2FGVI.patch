+try:
+    from mmcv.cnn import ConvModule
+    from mmcv.runner import load_checkpoint
+except ImportError:
+    class ConvModule(nn.Module):
+        """Small inference-compatible subset of mmcv.cnn.ConvModule."""
+        def __init__(self, in_channels, out_channels, kernel_size, stride=1,
+                     padding=0, norm_cfg=None, act_cfg=None):
+            super().__init__()
+            self.conv = nn.Conv2d(in_channels, out_channels, kernel_size,
+                                  stride=stride, padding=padding)
+            self.activate = nn.ReLU(inplace=True) if act_cfg is not None else None
+
+        def forward(self, x):
+            x = self.conv(x)
+            return self.activate(x) if self.activate is not None else x
+
+    def load_checkpoint(model, checkpoint, strict=True):
+        # E2FGVI's released checkpoint contains the complete SPyNet state and is
+        # loaded immediately after model construction.  The upstream mmcv call
+        # downloads an additional initialization checkpoint, which is redundant
+        # for inference and prevents the vendored model from running without
+        # mmcv-full.
+        if isinstance(checkpoint, str) and checkpoint.startswith(("http://", "https://")):
+            print("[compat] skip redundant SPyNet initialization download")
+            return {}
+        state = torch.load(checkpoint, map_location="cpu")
+        state = state.get("state_dict", state)
+        model.load_state_dict(state, strict=strict)
+        return state
 
 
